<select id="selectFacilityDataList" parameterType="facilityVO" resultType="egovframework.example.sample.service.FacilityVO">
		SELECT DISTINCT
		     A.FACILITY_ID 			AS facilityId
		    ,A.FACILITY_NAME 		AS facilityName 
		    ,B.PART_ID 					AS partId
		    ,C.STATUS_ID 				AS statusId
			,C.STATUS_NAME 		AS statusName
		FROM FACILITY A, FACILITY_PART B, FACILITY_STATUS C
		WHERE 1=1
		AND A.FACILITY_ID = B.FACILITY_ID
		AND A.FACILITY_ID = C.FACILITY_ID
		OFFSET #{firstIndex} ROWS FETCH NEXT #{recordCountPerPage} ROW ONLY
	</select>
</mapper>